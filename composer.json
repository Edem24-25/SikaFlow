{
  "name": "hoddglobal/sikaflow",
  "type": "project",
  "description": "SikaFlow \u2014 Plateforme automatis\u00e9e de gestion des remboursements de pr\u00eats et abonnements (HODD GLOBAL).",
  "keywords": [
    "laravel",
    "sikaflow",
    "fintech",
    "mobile-money",
    "abonnements",
    "pr\u00eats"
  ],
  "license": "proprietary",
    "require": {
    "php": "^8.2",
    "barryvdh/laravel-dompdf": "^3.0",
    "kkiapay/kkiapay-php": "^1.0",
    "laravel/breeze": "^2.0",
    "laravel/framework": "^11.0",
    "laravel/tinker": "^2.9",
    "resend/resend-php": "^0.14",
    "spatie/laravel-backup": "^9.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "laravel/sail": "^1.26",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "post-create-project-cmd": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
      "@php artisan key:generate --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "source",
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "php-http/discovery": true,
      "composer/installers": true
    },
    "policy": {
      "advisories": {
        "block": true
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
